<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PyrusLLM Docs</title>
<style>
  :root{
    --bg:#0b0d12; --panel:#12151c; --panel2:#171a21; --line:#242a37; --line2:#1b1f27;
    --tx:#e8ecf6; --tx2:#a9b4cc; --tx3:#7c8699;
    --accent:#5fa8ff; --accent2:#4a7dfc;
    --good:#4ade80; --goodbg:#12291c; --goodln:#1f4a31;
    --warn:#fbbf24; --warnbg:#2a2413; --warnln:#4a3d18;
    --bad:#f87171;  --badbg:#2d1618;  --badln:#542125;
    --code:#0d1017;
    --sidebar:270px;
  }
  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]){
      --bg:#ffffff; --panel:#f7f8fa; --panel2:#f1f3f7; --line:#e2e6ee; --line2:#eef1f6;
      --tx:#12151c; --tx2:#4a5468; --tx3:#6b7488;
      --accent:#1f6feb; --accent2:#1f6feb;
      --good:#136c39; --goodbg:#e8f7ee; --goodln:#b7e4c7;
      --warn:#8a5a00; --warnbg:#fdf4e0; --warnln:#f0d9a8;
      --bad:#b42318;  --badbg:#fdeceb;  --badln:#f5c2be;
      --code:#f5f7fa;
    }
  }
  :root[data-theme="light"]{
    --bg:#ffffff; --panel:#f7f8fa; --panel2:#f1f3f7; --line:#e2e6ee; --line2:#eef1f6;
    --tx:#12151c; --tx2:#4a5468; --tx3:#6b7488;
    --accent:#1f6feb; --accent2:#1f6feb;
    --good:#136c39; --goodbg:#e8f7ee; --goodln:#b7e4c7;
    --warn:#8a5a00; --warnbg:#fdf4e0; --warnln:#f0d9a8;
    --bad:#b42318;  --badbg:#fdeceb;  --badln:#f5c2be;
    --code:#f5f7fa;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth; scroll-padding-top:1.5rem}
  body{
    margin:0; background:var(--bg); color:var(--tx);
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:15px; line-height:1.65;
  }
  code,pre,.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}

  /* ---------------------------------------------------------------- shell */
  .wrap{display:flex; min-height:100vh; max-width:1500px; margin:0 auto}
  aside{
    width:var(--sidebar); flex:none; border-right:1px solid var(--line);
    position:sticky; top:0; height:100vh; overflow-y:auto; padding:1.4rem 0 3rem;
    background:var(--bg);
  }
  main{flex:1; min-width:0; padding:2.2rem 3rem 6rem; max-width:900px}
  @media(max-width:1000px){
    aside{position:fixed; left:0; top:0; z-index:60; transform:translateX(-100%);
      transition:transform .18s ease; box-shadow:0 0 40px rgba(0,0,0,.45)}
    aside.open{transform:none}
    main{padding:1.4rem 1.15rem 5rem}
    .wrap{display:block}
  }

  /* --------------------------------------------------------------- brand */
  .brand{display:flex; align-items:center; gap:.6rem; padding:0 1.3rem 1.1rem;
    border-bottom:1px solid var(--line2); margin-bottom:.9rem}
  .brand .mark{
    width:1.9rem;height:1.9rem;border-radius:7px;flex:none;
    background:linear-gradient(140deg,var(--accent),#a06cff);
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-weight:800;font-size:.82rem;letter-spacing:-.03em
  }
  .brand b{font-size:1rem; letter-spacing:-.01em}
  .brand .ver{
    font-size:.66rem; color:var(--tx3); border:1px solid var(--line);
    padding:.05rem .38rem; border-radius:999px; margin-left:auto
  }

  /* ------------------------------------------------------------- sidenav */
  nav .grp{
    font-size:.68rem; text-transform:uppercase; letter-spacing:.09em;
    color:var(--tx3); padding:1.1rem 1.4rem .35rem; font-weight:700
  }
  nav a{
    display:block; padding:.32rem 1.4rem; color:var(--tx2);
    text-decoration:none; font-size:.86rem; border-left:2px solid transparent
  }
  nav a:hover{color:var(--tx); background:var(--panel2)}
  nav a.on{color:var(--accent); border-left-color:var(--accent); background:var(--panel2)}
  nav a .m{
    font-size:.6rem; font-weight:700; padding:.02rem .3rem; border-radius:3px;
    margin-right:.4rem; vertical-align:1px; font-family:ui-monospace,monospace
  }
  .m.get{background:#12291c;color:#4ade80}
  .m.post{background:#1a2740;color:#7db8ff}
  .m.del{background:#2d1618;color:#f87171}
  :root[data-theme="light"] .m.get,
  :root:not([data-theme="dark"]) .m.get{background:#e8f7ee;color:#136c39}
  :root[data-theme="light"] .m.post,
  :root:not([data-theme="dark"]) .m.post{background:#e7f0fd;color:#1f6feb}
  :root[data-theme="light"] .m.del,
  :root:not([data-theme="dark"]) .m.del{background:#fdeceb;color:#b42318}

  /* -------------------------------------------------------------- topbar */
  .top{display:none}
  @media(max-width:1000px){
    .top{display:flex; align-items:center; gap:.7rem; padding:.7rem 1.15rem;
      border-bottom:1px solid var(--line); position:sticky; top:0; background:var(--bg); z-index:50}
    .top button{
      background:var(--panel2); color:var(--tx); border:1px solid var(--line);
      border-radius:7px; padding:.35rem .6rem; font-size:.9rem; cursor:pointer}
  }
  .scrim{display:none}
  .scrim.on{display:block; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:55}

  /* ------------------------------------------------------------ typography */
  h1{font-size:2.05rem; line-height:1.2; letter-spacing:-.025em; margin:.2rem 0 .5rem}
  h2{font-size:1.32rem; letter-spacing:-.015em; margin:2.8rem 0 .5rem;
     padding-top:1.1rem; border-top:1px solid var(--line2)}
  h2:first-of-type{border-top:0; padding-top:0}
  h3{font-size:1.02rem; margin:1.7rem 0 .4rem; letter-spacing:-.01em}
  h4{font-size:.9rem; margin:1.2rem 0 .35rem; color:var(--tx2)}
  p{margin:.6rem 0}
  .lede{font-size:1.06rem; color:var(--tx2); margin-bottom:1.4rem}
  a{color:var(--accent)}
  ul,ol{padding-left:1.25rem; margin:.6rem 0}
  li{margin:.22rem 0}
  hr{border:0;border-top:1px solid var(--line2);margin:2rem 0}
  strong{color:var(--tx)}

  p code,li code,td code,h3 code,h4 code{
    background:var(--panel2); border:1px solid var(--line);
    border-radius:4px; padding:.06rem .32rem; font-size:.85em
  }

  /* ---------------------------------------------------------------- code */
  pre{
    background:var(--code); border:1px solid var(--line); border-radius:9px;
    padding:.85rem 1rem; overflow-x:auto; margin:.7rem 0;
    font-size:.805rem; line-height:1.6
  }
  pre code{background:none;border:0;padding:0;font-size:inherit}
  .c-cm{color:var(--tx3)}
  .c-fl{color:#c7a9ff}
  .c-st{color:#86efac}
  .c-kw{color:#7db8ff}
  :root[data-theme="light"] .c-fl,:root:not([data-theme="dark"]) .c-fl{color:#7b3fd4}
  :root[data-theme="light"] .c-st,:root:not([data-theme="dark"]) .c-st{color:#136c39}
  :root[data-theme="light"] .c-kw,:root:not([data-theme="dark"]) .c-kw{color:#1f6feb}

  /* --------------------------------------------------------------- cards */
  .cards{display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:.85rem; margin:1.2rem 0}
  .card{
    background:var(--panel); border:1px solid var(--line); border-radius:11px;
    padding:1rem 1.05rem
  }
  .card .ico{font-size:1.15rem; margin-bottom:.35rem}
  .card b{display:block; margin-bottom:.2rem; font-size:.95rem}
  .card p{margin:0; font-size:.85rem; color:var(--tx2); line-height:1.55}
  .card.link{text-decoration:none; color:inherit; display:block; transition:border-color .13s}
  .card.link:hover{border-color:var(--accent)}

  /* ------------------------------------------------------------- callout */
  .note{
    border-radius:9px; padding:.7rem .9rem; margin:1rem 0; font-size:.875rem;
    line-height:1.55; border:1px solid
  }
  .note.i{background:var(--panel); border-color:var(--line); color:var(--tx2)}
  .note.g{background:var(--goodbg); border-color:var(--goodln); color:var(--good)}
  .note.w{background:var(--warnbg); border-color:var(--warnln); color:var(--warn)}
  .note.b{background:var(--badbg);  border-color:var(--badln);  color:var(--bad)}
  .note b{color:inherit}
  .note code{background:rgba(127,127,127,.16); border-color:transparent}

  /* --------------------------------------------------------------- table */
  .tw{overflow-x:auto; margin:.8rem 0}
  table{width:100%; border-collapse:collapse; font-size:.855rem; min-width:460px}
  th{
    text-align:left; font-size:.68rem; text-transform:uppercase; letter-spacing:.07em;
    color:var(--tx3); padding:.45rem .7rem; border-bottom:1px solid var(--line);
    font-weight:700; white-space:nowrap
  }
  td{padding:.5rem .7rem; border-bottom:1px solid var(--line2); vertical-align:top}
  td:first-child{white-space:nowrap}
  tr:last-child td{border-bottom:0}

  /* ------------------------------------------------------------ endpoint */
  .ep{
    display:flex; align-items:center; gap:.6rem; flex-wrap:wrap;
    background:var(--panel); border:1px solid var(--line); border-radius:9px;
    padding:.55rem .75rem; margin:1.4rem 0 .5rem; font-size:.87rem
  }
  .ep .v{
    font-size:.66rem; font-weight:800; padding:.14rem .42rem; border-radius:4px;
    font-family:ui-monospace,monospace; letter-spacing:.03em
  }
  .ep .p{font-family:ui-monospace,monospace; color:var(--tx); overflow-wrap:anywhere}
  .ep .auth{
    margin-left:auto; font-size:.68rem; color:var(--tx3); white-space:nowrap;
    border:1px solid var(--line); border-radius:999px; padding:.05rem .45rem
  }
  .ep .auth.open{color:var(--good); border-color:var(--goodln); background:var(--goodbg)}

  /* -------------------------------------------------------------- pills */
  .pills{display:flex; gap:.4rem; flex-wrap:wrap; margin:.9rem 0 0}
  .pill{
    font-size:.72rem; background:var(--panel2); border:1px solid var(--line);
    color:var(--tx2); padding:.12rem .55rem; border-radius:999px
  }

  .foot{margin-top:4rem; padding-top:1.2rem; border-top:1px solid var(--line2);
    color:var(--tx3); font-size:.8rem}
  .anch{color:var(--tx3); text-decoration:none; font-weight:400; opacity:0;
    transition:opacity .12s; margin-left:.4rem; font-size:.8em}
  h2:hover .anch,h3:hover .anch{opacity:1}
</style>
</head>
